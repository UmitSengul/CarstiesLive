<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Carsties.Host</RootNamespace>
  </PropertyGroup>

  <!--
    C1: tek host, tek Wolverine runtime (ADR-0006: store auctions/auctions_rmq).
    Surumler 6.25.3'te sabit: eski iki servis 6.24.5 / 6.25.2 karisimi kullaniyordu.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.25.3" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.25.3" />
    <PackageReference Include="WolverineFx.RabbitMQ" Version="6.25.3" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.25.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auction.Module\Auction.Module.csproj" />
    <ProjectReference Include="..\Bid.Module\Bid.Module.csproj" />
    <ProjectReference Include="..\Search.Module\Search.Module.csproj" />
    <ProjectReference Include="..\Notification.Module\Notification.Module.csproj" />
  </ItemGroup>

</Project>
