# ============================================================
# Carsties - VPS (production) ortam degiskenleri - ORNEK
#
# Kullanim:
#   cp deploy/.env.example deploy/.env
#   # asagidaki degerleri doldur (sirlari ASLA commit etme; .env gitignore'da)
#   docker compose --env-file deploy/.env \
#     -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build
# ============================================================

# --- Domainler (DNS A kayitlari VPS IP'sine bakmali) ---
APP_HOST=app.umitsengul.online
API_HOST=api.umitsengul.online
ID_HOST=id.umitsengul.online

# --- Let's Encrypt (acme-companion) ---
ACME_EMAIL=eposta@umitsengul.online
# Test icin true yapip sertifika limitlerini yakmamak mumkun:
LETSENCRYPT_TEST=false

# --- Uygulama sirlari ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTE_RANDOM
# Guclu bir parola (ozel karakterler ; ve = icermesin, connection string bozulur)
POSTGRES_PASSWORD=CHANGE_ME_GUCLU_PAROLA
RABBITMQ_USER=guest
RABBITMQ_PASS=CHANGE_ME_GUCLU_PAROLA
# Meilisearch production modunda en az 16 byte:
# openssl rand -hex 24
MEILI_MASTER_KEY=CHANGE_ME_MIN_16_BYTE
